// Yours, and the last file niri reads, so anything here beats both the seeds
// and the Hub's generated config. Seeded once and never touched by an update.
//
// Add a bind, override a setting, or drop in a window rule:
//
//   binds {
//       Mod+Shift+T { spawn "kitty"; }
//   }
//
// A chord already bound in rebinds.kdl is replaced by one you set here.

workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"

binds {
    Super+WheelScrollUp { focus-column-left; }
    Super+WheelScrollDown { focus-column-right; }
    Alt+Backslash { spawn-sh "flock -n -o /tmp/ryoshot.lock ryoku-qs -c ryoshot"; }
    Ctrl+Backslash { spawn-sh "flock -n -o /tmp/ryoshot.lock env RYOSHOT_MODE=monitor ryoku-qs -c ryoshot"; }
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    open-focused false
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

window-rule {
    match app-id="xdg-desktop-portal-gnome"
    open-focused false
}

window-rule {
    match app-id=r#"^steam_app_[0-9]+$"#
    open-fullscreen true
    open-focused true
    open-on-workspace "1"
}

window-rule {
    match app-id="ryomanager"
    default-floating-position x=0 y=0 relative-to="top-left"
}

window-rule {
    draw-border-with-background false
}

blur {
    passes 3
    offset 2
    noise 0.02
    saturation 1.5
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

debug {
    disable-direct-scanout
}
