// Generated by Ryoku Settings (Super + ,). Edit in the GUI, not here.

input {
    keyboard {
        xkb {
            layout "us,br"
            options "grp:alt_shift_toggle"
        }
        repeat-rate 20
        repeat-delay 250
    }
    touchpad {
        click-method "clickfinger"
        accel-speed 0.1
        accel-profile "flat"
    }
    mouse {
        accel-speed 0.1
        accel-profile "flat"
    }
    focus-follows-mouse
    warp-mouse-to-focus
}

layout {
    gaps 6
    default-column-width { proportion 0.5; }
    center-focused-column "never"
    always-center-single-column
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    border {
        off
    }
    focus-ring {
        on
        width 2
        active-color "#efc470"
        inactive-color "#17130b"
        urgent-color "#9b0000"
    }
    tab-indicator {
        width 4
        hide-when-single-tab
    }
}

animations {
    slowdown 0.745
    workspace-switch {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

cursor {
    xcursor-theme "Bibata-Material-Ryoku"
    xcursor-size 20
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

gestures {
    hot-corners {
        off
    }
}

overview {
    zoom 0.5
    backdrop-color "#1E1E1E"
}

recent-windows {
    off
}

environment {
    BROWSER "zen-beta --name zen-beta"
    XCURSOR_THEME "Bibata-Material-Ryoku"
    XCURSOR_SIZE "20"
}

spawn-sh-at-startup "easyeffects --hide-window --service-mode"
spawn-sh-at-startup "gsr-ui"

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.9
}

window-rule {
    match title="^Welcome to Ryoku$"
    open-floating true
    default-column-width { fixed 1180; }
    default-window-height { fixed 760; }
}

window-rule {
    match title="^Ryoku Settings$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id="^dev\\.ryoku\\.rashin$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 820; }
}

window-rule {
    match title="^ryoku-phone-.*$"
    open-floating true
    default-column-width { fixed 520; }
    default-window-height { fixed 860; }
}

window-rule {
    match app-id="^dev\\.ryoku\\.ryoport$"
    open-floating true
    default-column-width { fixed 1180; }
    default-window-height { fixed 760; }
}

window-rule {
    match app-id="ryoport_console"
    open-floating true
}

window-rule {
    match app-id="(v|V)ncviewer"
    open-floating true
}

window-rule {
    match title="Valen"
    open-floating false
}

window-rule {
    match title="Valen"
    open-maximized true
}

window-rule {
    match title="Valen"
    open-on-workspace "3"
}

window-rule {
    match title="astra"
    open-floating false
}

window-rule {
    match title="astra"
    open-maximized true
}

window-rule {
    match title="astra"
    open-on-workspace "3"
}

window-rule {
    match title="Discord"
    open-floating false
}

window-rule {
    match title="Discord"
    open-maximized true
}

window-rule {
    match title="Discord"
    open-on-workspace "2"
}

window-rule {
    match app-id="hyprland-share-picker"
    open-floating true
}

window-rule {
    match app-id="zen-beta"
    open-floating false
}

window-rule {
    match app-id="zen-beta"
    open-maximized true
}

layer-rule {
    match namespace="ryoku-overview-backdrop"
    place-within-backdrop true
}

