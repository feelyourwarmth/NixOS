// Generated by Ryoku Settings (Super + ,). Edit in the GUI, not here.

input {
    keyboard {
        xkb {
            layout "us,br"
            options "grp:alt_shift_toggle"
        }
        repeat-rate 20
        repeat-delay 250
    }
    touchpad {
        accel-speed 0.1
        accel-profile "flat"
    }
    mouse {
        accel-speed 0.1
        accel-profile "flat"
    }
    focus-follows-mouse
    warp-mouse-to-focus
}

layout {
    gaps 6
    default-column-width { proportion 0.5; }
    center-focused-column "never"
    always-center-single-column
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    border {
        off
    }
    focus-ring {
        on
        width 1
        active-color "#cacaca"
        inactive-color "#131313"
        urgent-color "#9b0000"
    }
    tab-indicator {
        width 4
        hide-when-single-tab
    }
}

cursor {
    xcursor-theme "Bibata-Material-Ryoku"
    xcursor-size 20
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

gestures {
    hot-corners {
        off
    }
}

overview {
    zoom 0.5
    backdrop-color "#1E1E1E"
}

recent-windows {
    off
}

environment {
    BROWSER "zen-beta --name zen-beta"
}

spawn-sh-at-startup "easyeffects --hide-window --service-mode"
spawn-sh-at-startup "gsr-ui"

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.9
}

window-rule {
    match title="^Welcome to Ryoku$"
    open-floating true
    default-column-width { fixed 1180; }
    default-window-height { fixed 760; }
}

window-rule {
    match title="^Rashin$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 820; }
}

window-rule {
    match title="Discord"
    open-maximized true
}

window-rule {
    match title="Zen"
    open-maximized true
}

window-rule {
    match app-id="discord-canary"
    open-on-workspace "2"
}

window-rule {
    match title="Ryotunes"
    open-on-workspace "3"
}

window-rule {
    match title="Sober"
    open-on-workspace "1"
}

window-rule {
    match title="Brave"
    open-maximized true
}

window-rule {
    match title="Vivaldi"
    open-maximized true
}

window-rule {
    match title="Steam"
    open-on-workspace "1"
}

layer-rule {
    match namespace="ryoku-overview-backdrop"
    place-within-backdrop true
}

